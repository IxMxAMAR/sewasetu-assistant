# Copy this to /opt/sewasetu/pilot.env on the host and fill it in.
# deploy/provision.sh reads it and generates the supervisor configuration from
# it, so this file is the whole deployment.

# Where people reach the portal. This is stamped into every sign-in token and
# into the discovery documents, so it has to be the address assistants and
# browsers actually use -- a wrong value here means nobody can sign in.
PUBLIC_BASE_URL=https://<pod-id>-8000.proxy.runpod.net

# The two MCP servers, as assistants reach them. These are the token audiences:
# a token minted for the citizen assistant is refused by the officer assistant.
CITIZEN_MCP_URL=https://<pod-id>-8101.proxy.runpod.net
OFFICER_MCP_URL=https://<pod-id>-8102.proxy.runpod.net

# Departmental login for the block officer. The evaluators are given this.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Flask session signing key. Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# The blocks the assistant may act in. Everything else is refused with a
# message that sends the citizen to the portal or the counter.
AGENT_PILOT_BLOCKS=Sonari,Namti
